#!/bin/sh
set -eu

project_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
sibling_python="$project_root/../mini-swe-agent/.venv/bin/python"
provider="${REPO_AGENT_PROVIDER:-huggingface}"

if [ -n "${REPO_AGENT_PYTHON:-}" ]; then
    python_bin="$REPO_AGENT_PYTHON"
elif [ -x "$sibling_python" ]; then
    python_bin="$sibling_python"
elif command -v python3 >/dev/null 2>&1; then
    python_bin=$(command -v python3)
elif command -v python >/dev/null 2>&1; then
    python_bin=$(command -v python)
else
    echo "Repo Agent could not find Python." >&2
    echo "Set REPO_AGENT_PYTHON to an existing Python interpreter." >&2
    exit 127
fi

if [ ! -x "$python_bin" ]; then
    echo "Repo Agent Python is not executable: $python_bin" >&2
    exit 127
fi

if [ -n "${PYTHONPATH:-}" ]; then
    export PYTHONPATH="$project_root/src:$PYTHONPATH"
else
    export PYTHONPATH="$project_root/src"
fi

exec "$python_bin" -m repo_agent.run.local --provider "$provider" "$@"
